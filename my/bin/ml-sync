#!/usr/bin/env bash
# Pull new course material from upstream, then merge it into your study branch.
# Safe to run any time: main is never edited, so the pull is always a fast-forward.
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# Jupyter/VSCode happily writes execution counts and outputs back into the upstream
# templates if you open them in place. Those edits are worthless and would fight the
# merge, so offer to throw them away.
DIRTY_UPSTREAM=$(git status --porcelain -- labs lectures exam README.md .gitignore | awk '{print $2}')
if [ -n "$DIRTY_UPSTREAM" ]; then
  echo "These upstream files have been modified locally (probably by running a notebook in place):"
  echo "$DIRTY_UPSTREAM" | sed 's/^/    /'
  echo
  read -r -p "Discard those changes and restore the pristine originals? [y/N] " ans
  if [ "${ans:-N}" = "y" ] || [ "${ans:-N}" = "Y" ]; then
    git checkout -- labs lectures exam README.md .gitignore 2>/dev/null || true
    find labs lectures exam -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
    find labs -name '.ipynb_checkpoints' -type d -exec rm -rf {} + 2>/dev/null || true
    echo "Restored. (Your own work in my/ was not touched.)"
  else
    echo "Leaving them. Note that your work belongs in my/ — see my/README.md."
    exit 1
  fi
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "You have uncommitted work in my/. Commit it first:"
  echo "    git add -A && git commit -m 'lab NN progress'"
  exit 1
fi

START_BRANCH=$(git rev-parse --abbrev-ref HEAD)
git checkout main --quiet
OLD=$(git rev-parse HEAD)
git pull --ff-only upstream main
NEW=$(git rev-parse HEAD)

if [ "$OLD" = "$NEW" ]; then
  echo "Already up to date."
  git checkout "$START_BRANCH" --quiet
  exit 0
fi

echo
echo "New / changed course material:"
git diff --name-status "$OLD" "$NEW" | sed 's/^/    /'
echo

git checkout study --quiet
git merge main -m "Merge upstream course updates"
echo
echo "Done. You are on branch: $(git rev-parse --abbrev-ref HEAD)"
echo "New lab released? Scaffold it with:  my/bin/ml-lab NN"
